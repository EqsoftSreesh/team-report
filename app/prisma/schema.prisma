generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("MEMBER") // ADMIN or MEMBER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports   Report[]
}

model Team {
  id        Int       @id @default(autoincrement())
  name      String
  color     String
  icon      String
  projects  Project[]
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  color     String
  status    String   @default("active")
  team      Team     @relation(fields: [teamId], references: [id])
  teamId    Int
  reports   Report[] @relation("ReportToProject")
}

model Report {
  id            Int      @id @default(autoincrement())
  date          String
  yesterdayWork String?
  issueFaced    String?
  solution      String?
  currentWork   String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  projects      Project[] @relation("ReportToProject")
  images        Image[]
  
  @@unique([userId, date])
}

model Image {
  id        Int      @id @default(autoincrement())
  base64    String
  report    Report   @relation(fields: [reportId], references: [id])
  reportId  Int
}
